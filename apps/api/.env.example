# Copy to apps/api/.env (gitignored). Loaded by pipeline CLIs via Node's
# native env-file support — no dotenv.

# Tagging pipeline (pnpm tag --provider anthropic). Create a key at
# https://console.anthropic.com/ — the full corpus costs ~$1-2 to tag.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI-compatible tagger (pnpm tag --provider openai, #7). Works against
# any /v1 chat-completions endpoint that supports json_schema response
# format: the 3090 box over the tailnet (llama-swap serves racedex-tagger
# and qwen3.6:27b by name), OpenAI, vLLM. TAGGER_API_KEY only if the
# endpoint requires auth — the local box does not.
#
# Left commented on purpose: code defaults stay the authority (PLAN.md), and
# anthropic is the default provider because it works for anyone with a key.
# Uncomment to point the tagger at the local box — the base URL is reachable
# only on the tailnet. Equivalent per-run: --provider openai --base-url ...
#TAGGER_PROVIDER=openai
#TAGGER_BASE_URL=http://100.107.113.74:11435/v1
#TAGGER_MODEL=qwen3.6:27b
#TAGGER_API_KEY=
