# Copy to apps/api/.env (gitignored). Loaded by pipeline CLIs via Node's
# native env-file support — no dotenv.

# Tagging pipeline (pnpm tag --provider anthropic). Create a key at
# https://console.anthropic.com/ — the full corpus costs ~$1-2 to tag.
ANTHROPIC_API_KEY=sk-ant-...

# Self-hosted tagger (pnpm tag --provider openai, #7). Points at any endpoint
# speaking the OpenAI /v1 chat-completions protocol with json_schema response
# format — llama-server, Ollama, vLLM. TAGGER_MODEL is whatever name your
# server serves the model under. TAGGER_API_KEY only if it requires auth;
# a local server usually does not.
#
# Left commented on purpose: code defaults stay the authority (PLAN.md), and
# anthropic is the default provider because it works for anyone with a key,
# whereas a self-hosted URL is specific to your network. Equivalent per-run:
# pnpm tag --provider openai --base-url http://... --model ...
#TAGGER_PROVIDER=openai
#TAGGER_BASE_URL=http://your-llm-host:11435/v1
#TAGGER_MODEL=qwen3.6:27b
#TAGGER_API_KEY=
